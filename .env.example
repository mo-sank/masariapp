# Masari client environment variables.
#
# Copy this file to `.env` and fill in the values for your environment.
# Only PUBLIC values belong here. Every variable MUST use the EXPO_PUBLIC_
# prefix so the Expo CLI inlines it into the app bundle at build time.
#
# WARNING: EXPO_PUBLIC_ values ship in plain text inside the app. Never put a
# secret here. Server-only secrets (MARKET_DATA_API_KEY, AUTH0_MGMT_DOMAIN,
# AUTH0_MGMT_CLIENT_ID, AUTH0_MGMT_CLIENT_SECRET, CRON_SECRET, and the Supabase
# service-role key) are Edge Function secrets and must never appear in this file
# or in the app.
#
# This file lists variable NAMES only. Do not commit real values.

# Auth0 (Native application + API audience)
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=

# Supabase (project URL + publishable anon key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Legal links shown in Settings. Optional: when unset the app falls back to a
# placeholder URL so the links stay tappable in development. Set these to the
# hosted Privacy Policy and Terms (served from docs/legal) before launch.
EXPO_PUBLIC_LEGAL_PRIVACY_URL=
EXPO_PUBLIC_LEGAL_TERMS_URL=

# Sentry crash reporting DSN. Optional: when unset, Sentry stays disabled (local
# development, tests). The DSN is a public client key, not a secret. Set it for
# preview/production builds and set SENTRY_AUTH_TOKEN in the EAS build env so
# source maps upload (that token IS sensitive and does not belong here).
EXPO_PUBLIC_SENTRY_DSN=
